# Application
APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Database
# Supabase PostgreSQL 연결 문자열은 실제 .env에만 입력합니다.
DATABASE_URL=
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:

# Authentication
SESSION_COOKIE_NAME=mozi_session
SESSION_TTL_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_SECRET=

# AI
# 실제 키는 이 파일이 아니라 로컬 .env에만 입력합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_ANALYSIS_MODE=live
